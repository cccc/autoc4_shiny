{
	"server": "autoc4.labor.koeln.ccc.de",
	"port": 9000,
	"clientIdPrefix": "shiny_",
	"debug": {
		"message": false,
		"connect": true,
		"disconnect": true,
		"pluginLoaded": true,
		"moduleLoaded": true,
		"sentMessage": true
	},
	"modules": [
		{
			"type": "interactivity",
			"subscribe": ["club/status/message"]
		},
		{
			"type": "dmx",
			"subscribe": ["dmx/+/+"]
		},
		{
			"type": "light",
			"subscribe": [
				"licht/+/+",
				"led/+/+",
				"power/+/+",
				"relais/+/+",
				"tasmota/+/+/POWER",
				"socket/+/+/+",
				"screen/+/+",
				"club/status"
			]
		},
		{
			"type": "heartbeat",
			"subscribe": ["heartbeat/#"]
		},
		{
			"type": "windows",
			"subscribe": ["fenster/+/+"]
		},
		{
			"type": "state",
			"options": {
				"openClass": "state-open",
				"closedClass": "state-closed",
				"disconnectedClass": "state-disconnected",
				"target": "body"
			},
			"subscribe": ["club/status"]
		},
		{
			"type": "presets",
			"subscribe": ["preset/list", "preset/+/list"]
		},
		{
			"type": "kitchenlight"
		},
		{
			"type": "music",
			"options": {
				"roleDataAttribute": "data-music-role",
				"topicDataAttribute": "data-music-topic",
				"playingClass": "music-playing",
				"pausedClass": "music-paused",
				"stoppedClass": "music-stopped"
			},
			"subscribe": ["mpd/+/state", "mpd/+/song"]
		},
		{
			"type": "notify",
			"options": {
				"textTemplate": "Shutdown was initiated."
			},
			"subscribe": ["club/shutdown"]
		},
		{
			"type": "notify",
			"options": {
				"textTemplate": "Gate was opened."
			},
			"subscribe": ["club/gate"]
		},
		{
			"type": "time",
			"options": {
				"targetSelector": "[data-time]",
				"templateDataAttribute": "data-time-template",
				"defaultToCurrentTime": true
			},
			"subscribe": ["time"]
		},
		{
			"type": "cyber",
			"options": {
				"class": "cyber",
				"target": "body",
				"keys": [38, 38, 40, 40, 37, 39, 37, 39, 66, 65]
			},
			"subscribe": ["club/cyber/alert"]
		},
		{
			"type": "admin",
			"options": {
				"class": "admin",
				"target": "body",
                "localStorageKey": "autoc4:admin:enabled",
                "clickTriggerSelector": ".state-display",
                "clickTimeout": 2000,
                "clickCount": 5
			}
		},
		{
			"type": "atem",
			"subscribe": ["atem/+/input-properties", "atem/#"]
		},
		{
			"type": "aten",
			"subscribe": ["aten/+/connection", "aten/+/state"]
		},
		{
			"type": "reload",
			"subscribe": ["interface/shiny/reload"]
		}
	]
}
